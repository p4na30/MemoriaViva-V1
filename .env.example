# ==============================================================================
# MemoriaViva RISE v3.0 - Environment Configuration
# Copy to .env and populate keys for live Gemini + Telegram features.
# Works 100% offline/without keys using the deterministic clinical fallback.
# ==============================================================================

# Google Gemini API Key (Zero-API-Key UX: injected on server/Cloud Run)
GEMINI_API_KEY=

# Centralized Telegram Bot Token for Deep-Linking (/start MV-XXXX)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=

# Data storage & GCP Cloud Run / GCS FUSE SQLite shielding
# Set MV_CLOUD_SYNC=1 when mounting /app/data on Cloud Storage FUSE
MV_DATA_DIR=data
MV_CLOUD_SYNC=0

# Server port (Cloud Run injects PORT automatically)
PORT=8080
